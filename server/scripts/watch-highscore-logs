#!/usr/bin/env python3
"""Tail Neon Stack highscore logs in a short, human-readable form.

Default: follow today's log from the end (like tail -f). Shows score submits,
replays, rejects, and highscore board reads. Skips CORS OPTIONS and duplicate
request/middleware noise.

Examples:
  watch-highscore-logs
  watch-highscore-logs -n 50          # print last 50 relevant lines, then follow
  watch-highscore-logs -v             # include OPTIONS / request noise
  watch-highscore-logs --no-follow -n 100
"""

from __future__ import annotations

import argparse
import os
import re
import sys
import time
from datetime import datetime
from pathlib import Path

LOG_DIR = Path(os.environ.get(
    "HIGHSCORE_LOG_DIR",
    "/home/kenwi/Work/tetris/server/data/logs",
))

TS_RE = re.compile(r"^\[(\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}:\d{2})\] \[(\w+)\]")
HTTP_RE = re.compile(r"HTTP (GET|POST|OPTIONS) ([^\s]+) -> (\d+)")
MSG_RE = re.compile(r"\] (?:[\w.]+): (.+)$")

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code: str, text: str) -> str:
    if not USE_COLOR:
        return text
    return f"\033[{code}m{text}\033[0m"


def message_body(line: str) -> str:
    # ASP.NET scopes put ClientIp/Origin/UserAgent before "] Type: message".
    # Prefer the trailing message so comma-separated fields parse cleanly.
    if "] " in line:
        return line.rsplit("] ", 1)[-1]
    return line


def kv(line: str) -> dict[str, str]:
    body = message_body(line)
    fields = (
        "ClientIp", "ModeId", "PlayerName", "FinalScore", "Rank", "Checksum",
        "Error", "RejectionCount", "SuspectedFake", "Bytes", "ProjectedRank",
        "HasReplay", "WindowMinutes", "Threshold", "Origin",
    )
    out: dict[str, str] = {}
    for name in fields:
        # Message fields are "Key=value, Key=value". Stop at comma.
        m = re.search(rf"{name}=([^,]+)", body)
        if m:
            out[name] = m.group(1).strip()
            continue
        # Fall back to scope header (space-separated before the closing bracket).
        m = re.search(rf"{name}=(\S+)", line)
        if m:
            out[name] = m.group(1).strip()
    return out


def short_ip(ip: str) -> str:
    if not ip or ip == "unknown":
        return "?"
    if ":" in ip:
        parts = ip.split(":")
        return ":".join(parts[:2] + ["…"] + parts[-1:]) if len(parts) > 3 else ip
    return ip


def short_ua(line: str) -> str:
    # Scope UA is space-separated and ends at "]" (no following Key=).
    m = re.search(r"UserAgent=(.+?)(?:\s+SpanId=|\s+TraceId=|\])", line)
    if not m:
        m = re.search(r"UserAgent=([^\]]+)", line)
    if not m:
        return ""
    ua = m.group(1)
    if "GodotEngine" in ua:
        return "godot"
    if "iPhone" in ua or "iPad" in ua:
        return "ios"
    if "Android" in ua:
        return "android"
    if "Firefox" in ua:
        return "firefox"
    if "Edg/" in ua:
        return "edge"
    if "Chrome" in ua:
        return "chrome"
    if "curl/" in ua:
        return "curl"
    return "browser"


def fmt_time(ts: str) -> str:
    try:
        dt = datetime.strptime(ts, "%d.%m.%Y %H:%M:%S")
        return dt.strftime("%H:%M:%S")
    except ValueError:
        return ts


def level_tag(level: str) -> str:
    if level == "WRN":
        return c("33", "WARN")
    if level == "ERR":
        return c("31", "ERR ")
    return c("32", "OK  ") if level == "INF" else level.ljust(4)


def format_line(line: str, verbose: bool) -> str | None:
    line = line.rstrip("\n")
    if not line:
        return None

    tm = TS_RE.match(line)
    if not tm:
        return None
    ts, level = tm.group(1), tm.group(2)
    clock = fmt_time(ts)
    f = kv(line)
    ua = short_ua(line)
    ip = short_ip(f.get("ClientIp", ""))

    if "JsonFileScoreStore initialized" in line:
        return None
    if "Configuration reloaded" in line or "Highscores server starting" in line:
        return None

    http = HTTP_RE.search(line)
    if http:
        method, path, code = http.group(1), http.group(2), http.group(3)
        path_short = path.split("?")[0]
        if method == "OPTIONS":
            if not verbose:
                return None
            return f"{clock}  cors   {method} {path_short} → {code}  {ip}"
        if method == "GET" and path_short.startswith("/api/scores"):
            mode = path_short.rstrip("/").rsplit("/", 1)[-1]
            top_m = re.search(r"[?&]top=(\d+)", path)
            top = top_m.group(1) if top_m else "?"
            status = "ok" if code == "200" else code
            return (
                f"{clock}  {c('36', 'READ  ')} {mode}  top={top}  → {status}  {ip}  {ua}"
            )
        if method == "GET" and path_short.startswith("/api/replays/"):
            if not verbose:
                return None
            checksum = path_short.rsplit("/", 1)[-1][:12]
            return f"{clock}  replay GET {checksum}… → {code}  {ip}"
        if method == "POST" and code.startswith("2") and not verbose:
            return None
        if method == "POST":
            tone = "reject" if code.startswith(("4", "5")) else "http"
            code_s = c("31", code) if code.startswith(("4", "5")) else code
            return f"{clock}  {tone:<6} {method} {path_short} → {code_s}  {ip}"
        if not verbose:
            return None
        return f"{clock}  http   {method} {path_short} → {code}  {ip}"

    if "POST /api/scores request:" in line or "POST /api/replays request:" in line:
        return None if not verbose else f"{clock}  req    scores/replays  {ip}  {ua}"
    if "GET /api/scores/" in line and ("request:" in line or "succeeded:" in line):
        # Prefer the concise middleware GET → READ line; skip Program duplicates.
        return None
    if "Leaderboard queried:" in line:
        return None
    if "Score submission received:" in line or "Score submission accepted for storage:" in line:
        return None

    name = f.get("PlayerName", "")
    mode = f.get("ModeId", "")
    score = f.get("FinalScore", "")
    rank = f.get("Rank", "")
    err = f.get("Error", "")

    if "POST /api/scores succeeded" in line:
        return (
            f"{clock}  {c('32', 'SCORE ')} {name or '?'}  {score}  "
            f"rank={rank or '?'}  {mode}  {ip}  {ua}"
        )

    if "Score persisted:" in line:
        return None

    if "duplicate checksum" in line or "rejected (duplicate)" in line:
        return (
            f"{clock}  {c('33', 'DUP   ')} {name or '?'}  {score}  {mode}  {ip}  "
            f"{err or 'duplicate checksum'}"
        )

    if "top 10 requires replay" in line or "Replay is required for top" in err:
        return (
            f"{clock}  {c('33', 'GATE  ')} {name or '?'}  {score}  "
            f"projected={f.get('ProjectedRank', '?')}  {mode}  {ip}  "
            f"{err or 'replay required'}"
        )

    if "Suspected fake score submission" in line:
        return (
            f"{clock}  {c('31', 'FAKE  ')} {name or '?'}  {score}  {mode}  {ip}  "
            f"checksum mismatch"
        )

    if "Score submission rejected (validation)" in line:
        return f"{clock}  {c('31', 'BAD   ')} {name or '?'}  {err}  {mode}"

    if "POST /api/scores rejected" in line:
        fake = f.get("SuspectedFake", "")
        rc = f.get("RejectionCount", "")
        tag = "FAKE  " if fake == "True" else "REJECT"
        color = "31" if fake == "True" or "Checksum" in err else "33"
        bits = [name or "?", score, mode, ip, ua]
        if rc:
            bits.append(f"n={rc}")
        if err:
            bits.append(err)
        return f"{clock}  {c(color, tag)} {'  '.join(x for x in bits if x)}"

    if "Repeat score rejection offender" in line:
        return (
            f"{clock}  {c('31', 'WATCH ')} repeat offender  {ip}  "
            f"count={f.get('RejectionCount', '?')}  "
            f"window={f.get('WindowMinutes', '?')}m  "
            f"threshold={f.get('Threshold', '?')}"
        )

    if "Replay attached:" in line:
        checksum = (f.get("Checksum") or "")[:12]
        return (
            f"{clock}  {c('32', 'REPLAY')} attached  {checksum}…  "
            f"{f.get('Bytes', '?')}B  {mode}  {ip}"
        )

    if "POST /api/replays succeeded" in line:
        return None

    if "POST /api/replays rejected" in line:
        checksum = (f.get("Checksum") or "")[:12]
        return (
            f"{clock}  {c('33', 'REPLAY')} rejected  {checksum}…  {mode}  {ip}  {err}"
        )

    if "Top-rank replay attached on submit" in line:
        return (
            f"{clock}  {c('32', 'REPLAY')} with score  rank={f.get('Rank', '?')}  "
            f"{f.get('Bytes', '?')}B  {mode}"
        )

    if "Discord" in line:
        return None if not verbose else f"{clock}  discord {message_body(line)[:140]}"

    if level in ("WRN", "ERR"):
        msg_m = MSG_RE.search(line)
        msg = msg_m.group(1) if msg_m else line[-160:]
        return f"{clock}  {level_tag(level)} {msg[:180]}"

    return None


def latest_log(log_dir: Path) -> Path | None:
    files = sorted(log_dir.glob("server-*.log"))
    return files[-1] if files else None


def iter_relevant_from_file(path: Path, verbose: bool):
    with path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            out = format_line(line, verbose)
            if out:
                yield out


def follow(log_dir: Path, verbose: bool, start_at_end: bool, backlog: int) -> None:
    path: Path | None = None
    fh = None
    inode = None
    printed_backlog = False

    try:
        while True:
            current = latest_log(log_dir)
            if current is None:
                print(f"# waiting for logs in {log_dir}", file=sys.stderr, flush=True)
                time.sleep(1.0)
                continue

            st = current.stat()
            rotated = path != current or inode != st.st_ino
            if rotated:
                if fh is not None:
                    fh.close()
                path = current
                inode = st.st_ino
                fh = path.open("r", encoding="utf-8", errors="replace")
                print(f"# following {path}", file=sys.stderr, flush=True)

                if not printed_backlog and backlog > 0:
                    fh.close()
                    relevant = list(iter_relevant_from_file(path, verbose))
                    for out in relevant[-backlog:]:
                        print(out, flush=True)
                    fh = path.open("r", encoding="utf-8", errors="replace")
                    fh.seek(0, os.SEEK_END)
                    printed_backlog = True
                elif start_at_end:
                    fh.seek(0, os.SEEK_END)

            assert fh is not None
            line = fh.readline()
            if not line:
                time.sleep(0.2)
                try:
                    if path.stat().st_ino != inode or path.stat().st_size < fh.tell():
                        inode = None
                except FileNotFoundError:
                    inode = None
                continue

            out = format_line(line, verbose)
            if out:
                print(out, flush=True)
    except KeyboardInterrupt:
        print("\n# stopped", file=sys.stderr)
    finally:
        if fh is not None:
            fh.close()


def main() -> int:
    p = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "-d", "--log-dir",
        type=Path,
        default=LOG_DIR,
        help=f"log directory (default: {LOG_DIR})",
    )
    p.add_argument(
        "-n", "--lines",
        type=int,
        default=30,
        help="show last N relevant lines before follow (default 30)",
    )
    p.add_argument("--no-follow", action="store_true", help="print backlog only, then exit")
    p.add_argument("-v", "--verbose", action="store_true", help="include OPTIONS, replay GETs, request noise")
    p.add_argument("--from-start", action="store_true", help="follow from start of current file (ignore -n)")
    args = p.parse_args()

    if not args.log_dir.is_dir():
        print(f"log dir not found: {args.log_dir}", file=sys.stderr)
        return 1

    path = latest_log(args.log_dir)
    if path is None:
        print(f"no server-*.log in {args.log_dir}", file=sys.stderr)
        return 1

    if args.no_follow:
        relevant = list(iter_relevant_from_file(path, args.verbose))
        n = args.lines if args.lines > 0 else len(relevant)
        for out in relevant[-n:]:
            print(out)
        return 0

    backlog = 0 if args.from_start else max(0, args.lines)
    follow(args.log_dir, args.verbose, start_at_end=True, backlog=backlog)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
