{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/server.log",
      "MinLevel": "Information"
    },
    "RejectionTracker": {
      "WindowMinutes": 10,
      "Threshold": 5
    }
  },
  "AllowedHosts": "*",
  "Highscores": {
    "FilePath": "highscores.json",
    "ReplayDirectory": "data/replays"
  },
  "Discord": {
    "WebhookUrl": "",
    "GameUrl": "",
    "AnnounceTopRanks": 10
  },
  "Cors": {
    "Origins": [
      "http://localhost:8060",
      "http://127.0.0.1:8060",
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  }
}
